<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dop.digital.mapper.DigitalCustomerMapper">

    <resultMap type="DigitalCustomer" id="DigitalCustomerResult">
        <id     property="customerId"    column="customer_id"    />
        <result property="customerName"  column="customer_name"  />
        <result property="phone"         column="phone"          />
        <result property="email"         column="email"          />
        <result property="address"       column="address"        />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectDigitalCustomerVo">
        select customer_id, customer_name, phone, email, address, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from biz_customer
    </sql>

    <select id="selectDigitalCustomerList" parameterType="DigitalCustomer" resultMap="DigitalCustomerResult">
        <include refid="selectDigitalCustomerVo"/>
        <where>
            del_flag = '0'
            <if test="customerName != null and customerName != ''">
                and customer_name like concat('%', #{customerName}, '%')
            </if>
            <if test="phone != null and phone != ''">
                and phone like concat('%', #{phone}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by customer_id desc
    </select>

    <select id="selectDigitalCustomerById" parameterType="Long" resultMap="DigitalCustomerResult">
        <include refid="selectDigitalCustomerVo"/>
        where customer_id = #{customerId} and del_flag = '0'
    </select>

    <insert id="insertDigitalCustomer" parameterType="DigitalCustomer" useGeneratedKeys="true" keyProperty="customerId">
        insert into biz_customer(
            customer_name,
            phone,
            email,
            address,
            status,
            del_flag,
            create_by,
            create_time,
            remark
        ) values (
            #{customerName},
            #{phone},
            #{email},
            #{address},
            #{status},
            '0',
            #{createBy},
            sysdate(),
            #{remark}
        )
    </insert>

    <update id="updateDigitalCustomer" parameterType="DigitalCustomer">
        update biz_customer
        <set>
            <if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="address != null">address = #{address},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where customer_id = #{customerId} and del_flag = '0'
    </update>

    <update id="deleteDigitalCustomerByIds" parameterType="Long">
        update biz_customer
        set del_flag = '2', update_time = sysdate()
        where customer_id in
        <foreach collection="array" item="customerId" open="(" separator="," close=")">
            #{customerId}
        </foreach>
    </update>

</mapper>
