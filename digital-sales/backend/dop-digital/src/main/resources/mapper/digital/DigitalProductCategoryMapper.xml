<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dop.digital.mapper.DigitalProductCategoryMapper">

    <resultMap type="DigitalProductCategory" id="DigitalProductCategoryResult">
        <id     property="categoryId"    column="category_id"    />
        <result property="categoryName"  column="category_name"  />
        <result property="orderNum"      column="order_num"      />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectDigitalProductCategoryVo">
        select category_id, category_name, order_num, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from biz_product_category
    </sql>

    <select id="selectDigitalProductCategoryList" parameterType="DigitalProductCategory" resultMap="DigitalProductCategoryResult">
        <include refid="selectDigitalProductCategoryVo"/>
        <where>
            del_flag = '0'
            <if test="categoryName != null and categoryName != ''">
                and category_name like concat('%', #{categoryName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by order_num, category_id
    </select>

    <select id="selectDigitalProductCategoryById" parameterType="Long" resultMap="DigitalProductCategoryResult">
        <include refid="selectDigitalProductCategoryVo"/>
        where category_id = #{categoryId} and del_flag = '0'
    </select>

    <select id="checkCategoryNameUnique" parameterType="String" resultMap="DigitalProductCategoryResult">
        <include refid="selectDigitalProductCategoryVo"/>
        where category_name = #{categoryName} and del_flag = '0' limit 1
    </select>

    <select id="countProductByCategoryId" parameterType="Long" resultType="int">
        select count(1) from biz_product where category_id = #{categoryId} and del_flag = '0'
    </select>

    <insert id="insertDigitalProductCategory" parameterType="DigitalProductCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into biz_product_category(
            category_name,
            order_num,
            status,
            del_flag,
            create_by,
            create_time,
            remark
        ) values (
            #{categoryName},
            #{orderNum},
            #{status},
            '0',
            #{createBy},
            sysdate(),
            #{remark}
        )
    </insert>

    <update id="updateDigitalProductCategory" parameterType="DigitalProductCategory">
        update biz_product_category
        <set>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId} and del_flag = '0'
    </update>

    <update id="deleteDigitalProductCategoryByIds" parameterType="Long">
        update biz_product_category
        set del_flag = '2', update_time = sysdate()
        where category_id in
        <foreach collection="array" item="categoryId" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </update>

</mapper>
