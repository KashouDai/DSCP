<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dop.digital.mapper.DigitalProductMapper">

    <resultMap type="DigitalProduct" id="DigitalProductResult">
        <id     property="productId"     column="product_id"     />
        <result property="categoryId"    column="category_id"    />
        <result property="productName"   column="product_name"   />
        <result property="brand"         column="brand"          />
        <result property="description"   column="description"    />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="categoryName"  column="category_name"  />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectDigitalProductVo">
        select p.product_id, p.category_id, p.product_name, p.brand, p.description,
               p.status, p.del_flag, p.create_by, p.create_time, p.update_by,
               p.update_time, p.remark, c.category_name
        from biz_product p
        left join biz_product_category c on c.category_id = p.category_id
    </sql>

    <select id="selectDigitalProductList" parameterType="DigitalProduct" resultMap="DigitalProductResult">
        <include refid="selectDigitalProductVo"/>
        <where>
            p.del_flag = '0'
            <if test="categoryId != null">
                and p.category_id = #{categoryId}
            </if>
            <if test="productName != null and productName != ''">
                and p.product_name like concat('%', #{productName}, '%')
            </if>
            <if test="brand != null and brand != ''">
                and p.brand like concat('%', #{brand}, '%')
            </if>
            <if test="status != null and status != ''">
                and p.status = #{status}
            </if>
        </where>
        order by p.product_id desc
    </select>

    <select id="selectDigitalProductById" parameterType="Long" resultMap="DigitalProductResult">
        <include refid="selectDigitalProductVo"/>
        where p.product_id = #{productId} and p.del_flag = '0'
    </select>

    <insert id="insertDigitalProduct" parameterType="DigitalProduct" useGeneratedKeys="true" keyProperty="productId">
        insert into biz_product(
            category_id,
            product_name,
            brand,
            description,
            status,
            del_flag,
            create_by,
            create_time,
            remark
        ) values (
            #{categoryId},
            #{productName},
            #{brand},
            #{description},
            #{status},
            '0',
            #{createBy},
            sysdate(),
            #{remark}
        )
    </insert>

    <update id="updateDigitalProduct" parameterType="DigitalProduct">
        update biz_product
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="brand != null">brand = #{brand},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where product_id = #{productId} and del_flag = '0'
    </update>

    <update id="deleteDigitalProductByIds" parameterType="Long">
        update biz_product
        set del_flag = '2', update_time = sysdate()
        where product_id in
        <foreach collection="array" item="productId" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </update>

</mapper>
