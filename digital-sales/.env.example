# ============================================================
# Digital Sales 平台环境变量模板
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交
# ============================================================

# ---------- 数据库与端口 ----------
# MySQL root 密码，启动前修改为真实密码
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_PORT=3307
REDIS_PORT=6382
BACKEND_PORT=8081
FRONTEND_PORT=8082

# ---------- 前后端内部调用 ----------
AI_AGENT_KEY=replace-with-local-key

# ---------- 大模型 ----------
# 三者任选其一即可，优先级：DASHSCOPE_API_KEY > DEEPSEEK_API_KEY > MODEL_API_KEY
# 未配置时 Agent 仍可启动，但模型调用能力不可用
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash-2026-07-15
MODEL_QUERY_PLAN_TIMEOUT_SECONDS=60

# ---------- Agent 认证 ----------
# 后端与 Agent 之间的内部调用密钥，两端必须一致；留空会导致该链路鉴权失败
AGENT_INTERNAL_KEY=
# Agent JWT 签名密钥，务必改为随机字符串
AGENT_SECRET_KEY=

# ---------- Agent 依赖服务 ----------
# local_mode=1 时强制使用本机地址，忽略下面的 host 配置
AGENT_LOCAL_MODE=0
MONGO_HOST=host.docker.internal
MONGO_PORT=27017
MONGO_DB=tools
MILVUS_URI=http://host.docker.internal:19530
MILVUS_DB_NAME=tool_db

# ---------- Agent 回访业务系统 ----------
DIGITAL_SALES_GATEWAY_URL=http://backend:8080
